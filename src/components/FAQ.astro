---
import { faqsData } from '../data/faqs';

// Generate Schema.org FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqsData.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq" class="faq-section" aria-labelledby="faq-title">
  <div class="container">
    <div class="faq-header">
      <div class="section-tag">
        <span>07 / FREQUENTLY ASKED QUESTIONS</span>
      </div>
      <h2 id="faq-title" class="section-title">
        常见问题解答 (FAQ)
      </h2>
      <p class="section-desc">
        关于 LinkCube 节点属性、资料核验、早晚高峰时延、两站价格冲突及更新追踪的十大高频核心问题。
      </p>
    </div>

    <div class="faq-accordion">
      {faqsData.map((item, index) => (
        <details class="faq-item" id={item.id}>
          <summary class="faq-question">
            <span class="faq-number font-mono">Q{index + 1 < 10 ? `0${index + 1}` : index + 1}</span>
            <span class="faq-q-text">{item.question}</span>
            <svg class="faq-chevron" viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </summary>

          <div class="faq-answer">
            <p>{item.answer}</p>
            {item.relatedArticleSlug && (
              <div class="faq-related-link">
                <span>相关延伸研读：</span>
                <a href={`/guides/${item.relatedArticleSlug}/`}>
                  {item.relatedArticleTitle} ↗
                </a>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Inject FAQ structured data -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    background: #08172B;
    border-bottom: 1px solid var(--divider);
  }

  .faq-header {
    margin-bottom: 3rem;
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .faq-item {
    background: var(--panel-dark);
    border: 1px solid var(--divider);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--accent-cyan);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .faq-question {
    padding: 1.25rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-light);
    display: flex;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-number {
    color: var(--accent-cyan);
    font-size: 1rem;
    font-weight: 800;
  }

  .faq-q-text {
    flex-grow: 1;
    line-height: 1.4;
  }

  .faq-chevron {
    color: var(--text-muted);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent-cyan);
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem 3.5rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.7;
    border-top: 1px solid rgba(41, 79, 105, 0.3);
    margin-top: 0.5rem;
    padding-top: 1rem;
  }

  .faq-related-link {
    margin-top: 1rem;
    background: rgba(8, 23, 43, 0.6);
    border-left: 2px solid var(--accent-blue);
    padding: 0.5rem 0.75rem;
    border-radius: 0 4px 4px 0;
    font-size: 0.85rem;
  }

  .faq-related-link a {
    color: var(--accent-cyan);
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .faq-answer {
      padding-left: 1.5rem;
    }
  }
</style>
