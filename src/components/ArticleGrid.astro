---
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const orderedSlugs = [
  'linkcube-region-evidence',
  'linkcube-entry-exit',
  'linkcube-time-series',
  'linkcube-data-quality',
  'linkcube-pricing-sources',
  'linkcube-region-updates'
];

const sortedArticles = orderedSlugs
  .map(slug => articles.find(a => (a.data.slug === slug || a.id === slug || a.id.startsWith(slug))))
  .filter(Boolean);
---

<section id="articles-center" class="articles-section" aria-labelledby="articles-title">
  <div class="container">
    <div class="articles-header">
      <div class="section-tag">
        <span>06 / ORIGINAL KNOWLEDGE BASE · 原创技术文章</span>
      </div>
      <h2 id="articles-title" class="section-title">
        LinkCube 技术分析与数据核验知识库
      </h2>
      <p class="section-desc">
        涵盖节点地区核查、中转与出口原理、时间序列测速、报告可信度审查、套餐冲突对照与资料持续更新。每篇均满足 1000–1800 汉字严谨篇幅，配备独立结构化数据。
      </p>
    </div>

    <div class="articles-grid">
      {sortedArticles.map((article, index) => {
        const data = article.data;
        const slug = data.slug || article.id.replace(/\.md$/, '');
        return (
          <article class="article-card">
            <div class="article-card-meta">
              <span class="article-order font-mono">0{index + 1}</span>
              <span class="article-category">{data.category}</span>
              <span class="article-read-time font-mono">约 {data.readTimeMinutes} 分钟</span>
            </div>

            <h3 class="article-card-title">
              <a href={`/guides/${slug}/`}>
                {data.title}
              </a>
            </h3>

            <p class="article-card-summary">
              {data.description}
            </p>

            <div class="article-tags-row">
              {data.tags.slice(0, 3).map((tag) => (
                <span class="article-tag">#{tag}</span>
              ))}
            </div>

            <div class="article-card-footer">
              <span class="font-mono" style="font-size: 0.8rem; color: var(--text-muted);">
                {data.pubDate}
              </span>
              <a href={`/guides/${slug}/`} class="read-more-link">
                <span>阅读全文</span>
                <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                  <path fill-rule="evenodd" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.44 8 6.22 4.28a.75.75 0 0 1 0-1.06z"/>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="articles-center-cta">
      <a href="/guides/" class="btn btn-secondary">
        进入完整文章中心与关键字检索 ↗
      </a>
    </div>
  </div>
</section>

<style>
  .articles-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    background: var(--bg-dark);
    border-bottom: 1px solid var(--divider);
  }

  .articles-header {
    margin-bottom: 3rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .article-card {
    background: var(--panel-dark);
    border: 1px solid var(--divider);
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-cyan);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .article-order {
    font-weight: 800;
    color: var(--accent-cyan);
    font-size: 0.9rem;
  }

  .article-category {
    background: rgba(41, 79, 105, 0.5);
    color: #EAF4FF;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .article-read-time {
    color: var(--text-muted);
    margin-left: auto;
  }

  .article-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .article-card-title a {
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  .article-card-title a:hover {
    color: var(--accent-cyan);
  }

  .article-card-summary {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex-grow: 1;
  }

  .article-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    font-size: 0.75rem;
    color: var(--accent-blue);
    background: rgba(60, 146, 212, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .article-card-footer {
    border-top: 1px solid var(--divider);
    padding-top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .articles-center-cta {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
