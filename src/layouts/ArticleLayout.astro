---
import BaseLayout from './BaseLayout.astro';
import { brand } from '../data/brand';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  author: string;
  category: string;
  tags: string[];
  coreKeywords: string[];
  readTimeMinutes: number;
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate = pubDate,
  author,
  category,
  tags,
  coreKeywords,
  readTimeMinutes,
  slug
} = Astro.props;

const canonicalUrl = `${brand.canonicalUrl}/guides/${slug}/`;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Organization",
    "name": author,
    "url": brand.canonicalUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": brand.name,
    "url": brand.canonicalUrl,
    "logo": "https://linkcube.rest/favicon.svg"
  },
  "datePublished": pubDate,
  "dateModified": updatedDate,
  "mainEntityOfPage": canonicalUrl,
  "inLanguage": "zh-CN",
  "keywords": coreKeywords.join(", ")
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": brand.canonicalUrl + "/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "技术指南",
      "item": brand.canonicalUrl + "/guides/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalUrl
    }
  ]
};
---

<BaseLayout
  title={`${title} - LinkCube 官方指南`}
  description={description}
  canonical={canonicalUrl}
  ogType="article"
  schema={[blogPostingSchema, breadcrumbSchema]}
>
  <div class="article-page-container">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb-nav" aria-label="页面路径导航">
        <ol class="breadcrumb-list">
          <li><a href="/">首页</a></li>
          <li><span class="bc-sep">/</span></li>
          <li><a href="/guides/">技术指南</a></li>
          <li><span class="bc-sep">/</span></li>
          <li aria-current="page"><span class="bc-current">{title}</span></li>
        </ol>
      </nav>

      <article class="main-article-wrapper">
        <header class="article-header">
          <div class="article-header-badge-row">
            <span class="section-tag" style="margin-bottom: 0;">{category}</span>
            <span class="status-badge status-reference">REFERENCE_ONLY 资料核验</span>
          </div>

          <h1 class="article-title">{title}</h1>

          <div class="article-meta-bar">
            <div class="meta-item">
              <span class="meta-label">发布机构：</span>
              <span class="meta-val">{author}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">发布时间：</span>
              <time datetime={pubDate} class="meta-val font-mono">{pubDate}</time>
            </div>
            {updatedDate && updatedDate !== pubDate && (
              <div class="meta-item">
                <span class="meta-label">核验更新：</span>
                <time datetime={updatedDate} class="meta-val font-mono">{updatedDate}</time>
              </div>
            )}
            <div class="meta-item">
              <span class="meta-label">阅读时间：</span>
              <span class="meta-val font-mono">约 {readTimeMinutes} 分钟</span>
            </div>
          </div>

          <div class="article-keywords-row">
            <span class="kw-label">核心索引词：</span>
            {coreKeywords.map(kw => (
              <span class="kw-pill">{kw}</span>
            ))}
          </div>
        </header>

        <!-- Article Body Markdown Content -->
        <div class="article-body-content">
          <slot />
        </div>

        <!-- In-article Action Banner -->
        <div class="article-action-box">
          <div class="action-box-left">
            <span class="action-badge font-mono">LINKCUBE SERVICE PORTAL</span>
            <h3 class="action-box-title">准备接入 LinkCube 全球网络专线？</h3>
            <p class="action-box-desc">
              遵循数据透明与客观原则。通过官方指定分发通道进入收银台，查看实时结算商品明细。
            </p>
          </div>
          <div class="action-box-right">
            <a
              href={brand.affiliateUrl}
              target="_blank"
              rel="sponsored nofollow noopener"
              class="btn btn-primary"
            >
              <span>立即注册与开通</span>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                <path fill-rule="evenodd" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.44 8 6.22 4.28a.75.75 0 0 1 0-1.06z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Footer Navigation for guides -->
        <nav class="article-footer-nav" aria-label="相关文章与目录">
          <a href="/guides/" class="btn btn-secondary">
            ← 返回技术指南中心
          </a>
          <a href="/#faq" class="btn btn-secondary">
            查看常见问题 FAQ →
          </a>
        </nav>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .article-page-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    background: var(--bg-dark);
  }

  .breadcrumb-nav {
    margin-bottom: 2rem;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .bc-sep {
    color: var(--divider);
  }

  .bc-current {
    color: var(--text-light);
    max-width: 400px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: inline-block;
  }

  .main-article-wrapper {
    background: var(--panel-dark);
    border: 1px solid var(--divider);
    border-radius: 12px;
    padding: 3rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
  }

  .article-header {
    border-bottom: 1px solid var(--divider);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .article-header-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .article-title {
    font-size: 2.15rem;
    font-weight: 800;
    color: var(--text-light);
    line-height: 1.3;
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    background: rgba(8, 23, 43, 0.6);
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
    border: 1px solid rgba(41, 79, 105, 0.35);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-val {
    color: var(--text-light);
    font-weight: 600;
  }

  .article-keywords-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .kw-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .kw-pill {
    background: rgba(60, 146, 212, 0.15);
    color: var(--accent-cyan);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(108, 221, 233, 0.25);
  }

  /* Article typography styling */
  .article-body-content {
    color: var(--text-light);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .article-body-content :global(h2) {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-light);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--divider);
  }

  .article-body-content :global(h3) {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-top: 2rem;
    margin-bottom: 0.85rem;
  }

  .article-body-content :global(p) {
    margin-bottom: 1.5rem;
    color: #D3E2F4;
  }

  .article-body-content :global(ol),
  .article-body-content :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #D3E2F4;
  }

  .article-body-content :global(li) {
    line-height: 1.7;
  }

  .article-body-content :global(strong) {
    color: #fff;
    font-weight: 700;
  }

  .article-action-box {
    margin-top: 3.5rem;
    background: linear-gradient(135deg, rgba(20, 46, 73, 0.8) 0%, rgba(10, 25, 45, 0.95) 100%);
    border: 1px solid var(--accent-cyan);
    border-radius: 10px;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .action-badge {
    font-size: 0.72rem;
    color: var(--accent-cyan);
    letter-spacing: 0.1em;
  }

  .action-box-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-light);
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .action-box-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .article-footer-nav {
    margin-top: 3rem;
    border-top: 1px solid var(--divider);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .main-article-wrapper {
      padding: 1.75rem;
    }
    .article-title {
      font-size: 1.65rem;
    }
    .article-action-box {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }
</style>
