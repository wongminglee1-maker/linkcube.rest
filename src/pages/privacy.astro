---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand } from '../data/brand';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": brand.canonicalUrl + "/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "隐私政策",
      "item": brand.canonicalUrl + "/privacy/"
    }
  ]
};
---

<BaseLayout
  title="LinkCube 隐私政策 (Privacy Policy) - linkcube.rest"
  description="LinkCube 数据落地页隐私政策，说明本站在数据收集、Cookie 使用、第三方外链与用户隐私保护方面的承诺。"
  canonical={`${brand.canonicalUrl}/privacy/`}
  schema={breadcrumbSchema}
>
  <div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
    <nav class="breadcrumb-nav" aria-label="页面路径导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li><span class="bc-sep">/</span></li>
        <li aria-current="page"><span class="bc-current">隐私政策</span></li>
      </ol>
    </nav>

    <div class="legal-card">
      <h1 class="legal-title">隐私政策 (Privacy Policy)</h1>
      <p class="legal-date font-mono">最后修订生效日期：2026 年 10 月 31 日</p>

      <div class="legal-content">
        <p>
          LinkCube (linkcube.rest，以下简称“本站”) 尊重并全力保护所有访问者的个人隐私权。本隐私政策旨在向您说明本站在您浏览内容、阅读文章或点击外部链接时所适用的信息处理原则。
        </p>

        <h2>1. 信息收集与使用</h2>
        <p>
          本站为纯静态托管的品牌数据落地页与技术科普站点。本站服务器本身<strong>不主动收集、不记录、不转让</strong>任何访问者的个人身份信息（如姓名、身份证号、家庭住址或私人通讯录）。为了保障站点的基础安全与防范恶意 DDoS 攻击，云端网络网关（如 Cloudflare）可能会自动记录临时的匿名访问日志（包含匿名化 IP、请求时间、User-Agent 等），该日志仅用于网络防护目的。
        </p>

        <h2>2. Cookie 与本地存储</h2>
        <p>
          本站不使用任何追踪性或跨站定向广告的第三方 Cookie。如果用户在图表组件中切换了“图形视图”或“数据表格”选项，该偏好设置仅保存在您本地浏览器的临时内存或 LocalStorage 中，不会上传至任何云端服务器。
        </p>

        <h2>3. 外部链接与第三方服务</h2>
        <p>
          本站包含跳转至第三方服务系统的注册与订阅链接（如 <code>varnexa.lingdongaff.com</code>）。当您点击此类外部链接时，您将离开本站并进入独立运营的结算平台。这些第三方系统拥有各自独立的隐私声明与服务条款。我们建议您在向任何第三方提交个人信息或进行支付前，仔细阅读该平台的隐私政策。
        </p>

        <h2>4. 数据安全承诺</h2>
        <p>
          本站全站强制采用现代标准的 HTTPS 加密传输（TLS 1.3），防止任何中间人监听、篡改或窃取传输数据。
        </p>

        <h2>5. 政策更新</h2>
        <p>
          若本站的信息处理实践发生变更，我们将在此页面发布修订后的隐私政策，并更新页面顶部的生效日期。
        </p>
      </div>

      <div style="margin-top: 2rem; border-top: 1px solid var(--divider); padding-top: 1rem;">
        <a href="/" class="btn btn-secondary">返回首页</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb-nav { margin-bottom: 2rem; }
  .breadcrumb-list { list-style: none; display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); }
  .bc-sep { color: var(--divider); }
  .bc-current { color: var(--text-light); }

  .legal-card {
    background: var(--panel-dark);
    border: 1px solid var(--divider);
    border-radius: 12px;
    padding: 3rem;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }
  .legal-title { font-size: 2.2rem; font-weight: 800; color: var(--text-light); margin-bottom: 0.5rem; }
  .legal-date { font-size: 0.85rem; color: var(--accent-cyan); margin-bottom: 2rem; border-bottom: 1px solid var(--divider); padding-bottom: 1rem; }
  .legal-content { color: #D3E2F4; font-size: 1rem; line-height: 1.8; }
  .legal-content h2 { font-size: 1.3rem; color: var(--text-light); margin-top: 1.75rem; margin-bottom: 0.75rem; }
  .legal-content p { margin-bottom: 1.25rem; }
</style>
