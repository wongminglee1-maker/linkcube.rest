---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { brand } from '../../data/brand';

const articles = await getCollection('articles');
const orderedSlugs = [
  'linkcube-region-evidence',
  'linkcube-entry-exit',
  'linkcube-time-series',
  'linkcube-data-quality',
  'linkcube-pricing-sources',
  'linkcube-region-updates'
];

const sortedArticles = orderedSlugs
  .map(slug => articles.find(a => (a.data.slug === slug || a.id === slug || a.id.startsWith(slug))))
  .filter(Boolean);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": brand.canonicalUrl + "/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "技术指南中心",
      "item": brand.canonicalUrl + "/guides/"
    }
  ]
};
---

<BaseLayout
  title="LinkCube 文章中心｜节点地区、线路技术与数据测速指南"
  description="浏览 LinkCube 官方发布的原创技术指南与数据核验手册，覆盖节点地区甄别、入口出口拓扑、早晚高峰测速、报告误差检查、双源套餐冲突与版本维护。"
  canonical={`${brand.canonicalUrl}/guides/`}
  schema={breadcrumbSchema}
>
  <div class="guides-page-container">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="页面路径导航">
        <ol class="breadcrumb-list">
          <li><a href="/">首页</a></li>
          <li><span class="bc-sep">/</span></li>
          <li aria-current="page"><span class="bc-current">技术指南中心</span></li>
        </ol>
      </nav>

      <div class="guides-hero">
        <div class="section-tag">
          <span>KNOWLEDGE BASE · 知识库</span>
        </div>
        <h1 class="section-title">
          LinkCube 技术指南与网络数据核验中心
        </h1>
        <p class="section-desc">
          我们坚持撰写客观、可复核的深度长文。每篇文章均深入网络工程底层机制，拒绝机械堆砌关键词，帮助用户在复杂的网络环境中建立科学的决策体系。
        </p>

        <!-- Search Bar -->
        <div class="search-bar-box">
          <div class="search-input-wrapper">
            <svg class="search-icon" viewBox="0 0 20 20" width="18" height="18" fill="currentColor">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
            </svg>
            <input
              type="search"
              id="article-search-input"
              class="article-search-input"
              placeholder="搜索文章关键词（如：香港节点、晚高峰、丢包率、套餐冲突、出口识别）..."
              aria-label="搜索技术文章"
            />
          </div>
          <span id="article-match-count" class="match-count font-mono">
            全部 {sortedArticles.length} 篇技术指南
          </span>
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="guides-cards-grid">
        {sortedArticles.map((article, index) => {
          const data = article.data;
          const slug = data.slug || article.id.replace(/\.md$/, '');
          return (
            <article
              class="article-card article-card-item"
              data-article-title={data.title}
              data-article-summary={data.description}
              data-article-tags={data.tags.join(' ')}
            >
              <div class="article-card-meta">
                <span class="article-order font-mono">0{index + 1}</span>
                <span class="article-category">{data.category}</span>
                <span class="article-read-time font-mono">约 {data.readTimeMinutes} 分钟</span>
              </div>

              <h2 class="article-card-title">
                <a href={`/guides/${slug}/`}>
                  {data.title}
                </a>
              </h2>

              <p class="article-card-summary">
                {data.description}
              </p>

              <div class="article-tags-row">
                {data.tags.map(tag => (
                  <span class="article-tag">#{tag}</span>
                ))}
              </div>

              <div class="article-card-footer">
                <span class="font-mono" style="font-size: 0.8rem; color: var(--text-muted);">
                  {data.pubDate}
                </span>
                <a href={`/guides/${slug}/`} class="read-more-link">
                  <span>阅读全文</span>
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
                    <path fill-rule="evenodd" d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.44 8 6.22 4.28a.75.75 0 0 1 0-1.06z"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <div id="article-empty-search" style="display: none; padding: 3rem; text-align: center; color: var(--text-muted);">
        <p style="font-size: 1.1rem; color: var(--text-light); margin-bottom: 0.5rem;">未找到与搜索词匹配的文章</p>
        <p style="font-size: 0.9rem;">请尝试更换关键词，如“延迟”、“专线”、“出口”等。</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .guides-page-container {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
    background: var(--bg-dark);
  }

  .breadcrumb-nav {
    margin-bottom: 2rem;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .bc-sep {
    color: var(--divider);
  }

  .bc-current {
    color: var(--text-light);
  }

  .guides-hero {
    margin-bottom: 3.5rem;
  }

  .search-bar-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--panel-dark);
    border: 1px solid var(--divider);
    border-radius: 8px;
    padding: 0.75rem 1.25rem;
    margin-top: 2rem;
    max-width: 860px;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .search-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .article-search-input {
    background: none;
    border: none;
    color: var(--text-light);
    font-size: 0.95rem;
    width: 100%;
    outline: none;
  }

  .article-search-input::placeholder {
    color: #6C8199;
  }

  .match-count {
    font-size: 0.82rem;
    color: var(--accent-cyan);
    white-space: nowrap;
  }

  .guides-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .article-card {
    background: var(--panel-dark);
    border: 1px solid var(--divider);
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-cyan);
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .article-order {
    font-weight: 800;
    color: var(--accent-cyan);
    font-size: 0.9rem;
  }

  .article-category {
    background: rgba(41, 79, 105, 0.5);
    color: #EAF4FF;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .article-read-time {
    color: var(--text-muted);
    margin-left: auto;
  }

  .article-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .article-card-title a {
    color: var(--text-light);
    text-decoration: none;
  }

  .article-card-title a:hover {
    color: var(--accent-cyan);
  }

  .article-card-summary {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex-grow: 1;
  }

  .article-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .article-tag {
    font-size: 0.75rem;
    color: var(--accent-blue);
    background: rgba(60, 146, 212, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .article-card-footer {
    border-top: 1px solid var(--divider);
    padding-top: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  @media (max-width: 1024px) {
    .guides-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .guides-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<script src="../../scripts/article-search.ts"></script>
